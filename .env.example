SECRET_KEY=replace-with-a-random-secret

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_DATABASE=Paking_Car_Sysetem

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:1.5b

# 模型路径可相对于项目根目录，也可使用绝对路径
DETECTION_MODEL_PATH=runs/license_plate/weights/best.pt
RECOGNITION_MODEL_PATH=recognize/plate_rec_color.pth
# auto 自动选择 CUDA / MPS / CPU，也可指定 cpu、mps、cuda:0
INFERENCE_DEVICE=auto
DETECTION_CONFIDENCE=0.25
DETECTION_IMAGE_SIZE=1024
MAX_UPLOAD_MB=10
# 可选：上传结果存储目录，默认为系统临时目录下 parking_management_system
# PARKING_RUNTIME_DIR=/path/to/runtime
